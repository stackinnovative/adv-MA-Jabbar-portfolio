# Copy to .env.local and fill in. Also add these to the hosting provider (Vercel / Netlify).

# sanity.io/manage → your project → Project ID
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Any long random string; the same value goes in the Sanity webhook's "Secret".
SANITY_REVALIDATE_SECRET=

# Production URL, used for absolute social-share image links.
NEXT_PUBLIC_SITE_URL=https://www.advmajabbar.com

# Enquiry form email (resend.com → API Keys). Without it the form opens the visitor's email app instead.
RESEND_API_KEY=
# Sender shown on enquiry emails; its domain must be verified in Resend.
ENQUIRY_FROM=Website enquiry <enquiry@advmajabbar.com>
